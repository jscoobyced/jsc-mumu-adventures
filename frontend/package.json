{
  "name": "jsc-mumu-adventures",
  "version": "0.0.53",
  "description": "The adventures of Mumu!",
  "main": "index.js",
  "repository": "https://github.com/jscoobyced/jsc-mumu-adventures",
  "author": "Cedric Rochefolle",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "gen-map": "ts-node src/utils/generate-map-data.ts",
    "split-sprite": "ts-node src/utils/split-sprites.ts",
    "format": "prettier --write .",
    "update-version": "./scripts/update-version.sh",
    "create-tag": "./scripts/create-tag.sh",
    "full-tag": "yarn update-version && yarn create-tag",
    "prepare": "cd .. && git init --quiet"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.16"
  }
}
